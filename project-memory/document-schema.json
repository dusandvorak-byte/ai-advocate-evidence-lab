{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dusandvorak-byte.github.io/ai-advocate-evidence-lab/project-memory/document-schema.json",
  "title": "Evidence Lab canonical document record",
  "type": "object",
  "required": ["id", "user_title", "issue_date", "institution_id", "reference", "document_type", "public"],
  "properties": {
    "id": {"type": "string", "pattern": "^doc-[a-z0-9-]+$"},
    "user_title": {"type": "string", "minLength": 1},
    "issue_date": {"type": "string", "format": "date"},
    "received_date": {"type": ["string", "null"], "format": "date"},
    "institution_id": {"type": "string", "minLength": 1},
    "reference": {"type": "string"},
    "case_ids": {"type": "array", "items": {"type": "string"}, "default": []},
    "document_type": {"type": "string"},
    "direction": {"type": "string", "enum": ["incoming", "outgoing", "internal", "unknown"], "default": "incoming"},
    "source_origin": {"type": "string", "enum": ["internal_upload", "external_https", "email_attachment", "repository", "manual_record"], "default": "internal_upload"},
    "topics": {"type": "array", "items": {"type": "string"}, "default": []},
    "public": {
      "type": "object",
      "required": ["html", "pdf", "sha256", "verification_status"],
      "properties": {
        "html": {"type": ["string", "null"], "pattern": "^(?!web/).*$"},
        "pdf": {"type": ["string", "null"], "pattern": "^(?!web/).*$"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "verification_status": {"type": "string", "enum": ["catalogued", "file_present", "hash_verified", "public_verified", "withheld", "missing"]}
      },
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "target_id": {"type": "string"},
          "relation_type": {"type": "string"},
          "document_id": {"type": "string"}
        },
        "additionalProperties": true
      },
      "default": []
    },
    "relevance": {
      "type": "object",
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 9},
        "basis": {"type": ["string", "null"]},
        "human_reviewed": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "legal_links": {
      "type": "object",
      "properties": {
        "statute_ids": {"type": "array", "items": {"type": "string"}},
        "case_law_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
